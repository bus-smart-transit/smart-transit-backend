APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION — local Docker PostgreSQL
# ──────────────────────────────────────────────────────────────────────────────
#
# Choose a password. It must be the same as LOCAL_DB_PASSWORD and DB_PASSWORD in the root .env, then run:
#   docker compose down && docker compose up -d
#
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_transit
DB_USERNAME=postgres
DB_PASSWORD=
#
# ──────────────────────────────────────────────────────────────────────────────

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
APP_FRONTEND_URL=""

# Batch 15, Items 2/3: Firebase Cloud Messaging. Leave unset to use the
# default path (storage/app/private/firebase-service-account.json) — place
# the downloaded service-account JSON there (gitignored, never commit it).
# Only set this if you need to point at a different location/filename.
FIREBASE_CREDENTIALS=

# Batch 27 Part 2: from the second leg of a shift block on, the bus must be at that leg's origin terminal
# before the leg can start. Default is true and must stay true in any real deployment. Setting it to false
# is for a DEV machine with no GPS feed only (a leg could then start anywhere).
SHIFT_BLOCK_LEG_LOCATION_RULE=true

# Batch 28 Stage 3: the step a computed fare is rounded to (nearest or ceiling, per fare rule). Adviser decision:
# the WHOLE PESO. Use 0.01 only to compare against old centavo fares.
FARE_ROUNDING_INCREMENT=1.00

# ── Services the running system uses ────────────────────────────────────────────
# When the backend runs in Docker, these come from the ROOT .env (see the .env.example next to docker-compose.yml).
# Set them here only if you run PHP on your own computer (composer install, php artisan serve, php vendor/bin/pest).

# REQUIRED to create or edit routes: OpenRouteService draws the route lines and works out distances and times.
ORS_API_KEY=
ORS_PROFILE=driving-car

# Optional: TomTom live traffic for the driver map. Leave empty to turn it off.
TOMTOM_KEY=
TOMTOM_TRAVEL_MODE=bus

# Email. "log" only writes emails to the log file. Use "resend" and a key to really send them.
# MAIL_MAILER=resend
RESEND_API_KEY=
# For testing: send every email to this one address.
MAIL_INTERCEPT_EMAIL=

# The websites allowed to call this backend, separated by commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Push notifications: the whole service-account JSON on one line (alternative to FIREBASE_CREDENTIALS above).
FIREBASE_CREDENTIALS_JSON=

# Developer only: lets "php artisan gps:simulate" move a bus. Keep false.
GPS_SIMULATOR_ENABLED=false

# Developer shortcuts. They only work when APP_ENV=local. Never use them for real users.
# DISABLE_STAFF_OTP=true       skips the emailed sign-in code for staff
# DISABLE_STEP_UP=true         skips the extra password check for sensitive staff actions
# RATE_LIMITING_ENABLED=false  switches off every rate limit